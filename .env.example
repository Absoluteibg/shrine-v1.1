# Copy this file to .env and adjust values for your environment.
# .env itself is gitignored — never commit real secrets.

# development | production
ENV=development
DEBUG=true

# --- Database ---
#
# SQLite is fine for local development — zero setup, works out of the
# box with the default below. PostgreSQL is the production database
# (verified in Phase 6: the exact same codebase, migrations, and test
# suite run unchanged against both — only this one value differs).
#
# SQLite (default, local dev):
DATABASE_URL=sqlite:///./shrine.db
#
# PostgreSQL (production):
#   DATABASE_URL=postgresql+psycopg2://shrine:your-password@localhost:5432/shrine
#
# Create the database and a dedicated role first:
#   sudo -u postgres psql -c "CREATE USER shrine WITH PASSWORD 'your-password';"
#   sudo -u postgres psql -c "CREATE DATABASE shrine OWNER shrine;"
# Then `alembic upgrade head` against it exactly as you would for SQLite.

# Used for session signing / CSRF once auth exists (Phase 4).
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED to be overridden before ENV=production — the app refuses to
# start in production with the default value.
SECRET_KEY=dev-only-insecure-secret-change-me

# SHRINE has exactly one admin account (the site's author) — no
# registration flow, no user table. Both are REQUIRED to be overridden
# before ENV=production; the app refuses to start otherwise.
#
# Generate a real password hash with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-real-password', bcrypt.gensalt()).decode())"
#
# Leaving these unset uses a dev-only default: username "admin",
# password "changeme123".
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=$2b$12$...
